#!/usr/bin/env bash
# csharp-ls, behind a proxy that picks the solution from the first .cs file
# opened rather than from the session's root -- see csharp-ls-proxy.js.
#
# This exists because csharp-ls loads one solution, chosen before it starts,
# and rooted at a monorepo it finds none and answers every query with an empty
# result instead of an error. Roslyn's own LSP binary is no better: it has no
# --solution flag at all and Claude Code never sends the custom solution/open
# notification it would need instead.
set -euo pipefail
export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.local/share/dotnet}"
export PATH="$HOME/.dotnet/tools:$DOTNET_ROOT:/opt/homebrew/bin:/usr/local/bin:$PATH"

exec node "$(dirname "$0")/csharp-ls-proxy.js" "$@"
