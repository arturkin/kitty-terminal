#!/usr/bin/env bash
# Roslyn's LSP server. Unlike the brief's original template, this build has no
# --solution flag (confirmed via --help and by trying it: "Unrecognized command
# or argument '--solution'") -- the binary only exposes custom LSP notification
# methods `solution/open` / `project/open` (found via `strings` on the DLL) for
# a client to send after `initialized`. A generic LSP client, Claude Code
# included, never sends those, so the server runs in its "misc files" mode.
#
# KNOWN LIMITATION, confirmed by raw stdio probe against monorepo's
# service-car/CarService/Program.cs: the file is bound to a synthetic
# "Canonical.csproj" (logged by the server itself as having "unresolved
# dependencies"), not the file's real .csproj. hover/goToDefinition work for
# local variables and bare BCL types (e.g. `args` as string[]) but return
# null/empty for anything the real project provides -- a type from another
# project or a NuGet package (tried: an extension method from the
# Travelshift.OpenTelemetry package, referenced via PackageReference).
# documentSymbol on that file also came back `[]`, not just semantics.
# csharp-ls (a different C# LSP server, takes --solution directly) DOES
# return real hover for that same symbol when pointed at the correct .sln --
# but this monorepo has ~126 disjoint .sln files and no single global one, so
# a single static server command/workspaceFolder (this plugin's model, and
# Claude Code's) can't pick the right one per file either; tested without
# --solution and it silently loaded an unrelated .sln, still returning null.
# So neither server gives working cross-project semantics here without
# further per-file solution-routing work. Shipped anyway for local-scope
# hover/completion and because it's a strict improvement over no C# server.
set -euo pipefail
export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.local/share/dotnet}"
export PATH="$DOTNET_ROOT:/opt/homebrew/bin:/usr/local/bin:$PATH"

dll="${ROSLYN_LS_DLL:-$HOME/.local/share/roslyn-ls/Microsoft.CodeAnalysis.LanguageServer.dll}"

logs="${TMPDIR:-/tmp}/roslyn-ls"; mkdir -p "$logs"

exec dotnet "$dll" --stdio --logLevel Warning \
  --extensionLogDirectory "$logs" "$@"
