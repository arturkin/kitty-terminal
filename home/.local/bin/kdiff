#!/usr/bin/env bash
# The whole change set in one view: file tree on the left, syntax-highlighted
# diff on the right.
#
#   kdiff                every change on this branch, committed or not
#   kdiff HEAD           uncommitted only (working tree + index)
#   kdiff --staged       the index
#   kdiff HEAD~3         against an older commit
#   kdiff -k [args]      force the kitten diff view (side-by-side, images)
#   kdiff -w [args]      in a new kitty OS window
#   kdiff -t [args]      in a new kitty tab
#
# Bare kdiff measures from where this branch left the base branch, so a local
# commit does not empty it out. Base is $KDIFF_BASE, else origin's default
# branch, else origin/master, origin/main, master, main.
#
# Viewer: diffnav (file tree on the left, GitHub style) when installed, else
# kitten diff. $KDIFF_VIEWER=kitten|diffnav overrides; -k forces kitten diff,
# which is the one that renders images.
#
# Keys in diffnav: ? or F1 lists them - moving between files, toggling the file
# tree, side-by-side vs unified, and search.
# Keys in kitten diff: j/k scroll, n/p next/previous change, / search, a all
# context, q quit. Untracked files are not shown - git diff does not see them.
set -uo pipefail

# kitty's `launch` (what cmd+shift+g uses) runs with the GUI app's PATH -- no
# Homebrew, no ~/.local/bin, because it never sources a login shell. Resolve
# the viewers here instead of depending on the caller's environment.
for _d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
  case ":$PATH:" in
    *":$_d:"*) ;;
    *) [ -d "$_d" ] && PATH="$PATH:$_d" ;;
  esac
done
unset _d
export PATH

pause() { [ -t 0 ] && { printf '\npress any key to close'; read -rsn1 </dev/tty 2>/dev/null; echo; }; }

where=here
force_kitten=
while [ "$#" -gt 0 ]; do
  case "$1" in
    -w|--window) where=os-window;  shift ;;
    -t|--tab)    where=tab;        shift ;;
    -k|--kitten) force_kitten=yes; shift ;;
    -h|--help)   sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
done

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "kdiff: not inside a git repository: $PWD" >&2
  pause; exit 1
fi

if [ "$where" != here ]; then
  exec kitten @ launch --type="$where" --cwd "$PWD" \
    --title "diff: $(basename "$(git rev-parse --show-toplevel)")" \
    --os-window-title "diff: $(basename "$(git rev-parse --show-toplevel)")" \
    "$0" ${force_kitten:+-k} "$@"
fi

# The base this branch forked from. Bare kdiff diffs the working tree against
# that merge base, so committed, staged and unstaged changes all show at once.
base_ref() {
  local r
  if [ -n "${KDIFF_BASE:-}" ]; then printf '%s\n' "$KDIFF_BASE"; return; fi
  if r=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "$r"; return
  fi
  for r in origin/master origin/main master main; do
    if git rev-parse --verify -q "$r" >/dev/null 2>&1; then printf '%s\n' "$r"; return; fi
  done
  printf 'HEAD\n'
}

label=
if [ "$#" -eq 0 ]; then
  base=$(base_ref)
  if spec=$(git merge-base "$base" HEAD 2>/dev/null); then
    label=" on this branch (vs $base)"
  else
    # No shared history with the base -- fall back to uncommitted only.
    spec=HEAD
    label=" (uncommitted; no merge base with $base)"
  fi
  set -- "$spec"
fi

if [ -z "$(git diff --name-only "$@" 2>/dev/null | head -1)" ]; then
  echo "kdiff: no changes${label:-${*:+ for: $*}}"
  pause; exit 0
fi

# diffnav is a pager over `git diff`; kitten diff is a difftool over the tree.
viewer="${KDIFF_VIEWER:-}"
[ -n "$force_kitten" ] && viewer=kitten
if [ -z "$viewer" ]; then
  if command -v diffnav >/dev/null 2>&1; then viewer=diffnav; else viewer=kitten; fi
fi
if [ "$viewer" = diffnav ] && ! command -v diffnav >/dev/null 2>&1; then
  echo "kdiff: diffnav not found (brew install diffnav) - using kitten diff" >&2
  viewer=kitten
fi

if [ "$viewer" = diffnav ]; then
  git diff "$@" | diffnav
  exit "${PIPESTATUS[0]}"
fi

exec git difftool --dir-diff --no-prompt --tool=kitty "$@"
