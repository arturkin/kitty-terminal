#!/usr/bin/env python3
"""What is running in every kitty pane, and a way to kill it.

kitty is the registry: `kitty @ ls` reports every OS window, tab and pane
along with the processes in each pane's foreground group. This walks down
from every window of every pane and reports each real command it finds, with
everything running underneath it nested below -- so a Claude Code pane is a
`claude` row carrying its MCP servers, its language server and every command
the agent currently has running. Shells that only stand in front of a command
are walked through rather than listed. CPU and memory on a job row cover its
whole subtree, which is what a kill takes down.

A job whose parent dies is adopted by launchd and leaves every pane's tree
while still running -- a dev server whose shell exited, still holding its
port. Its environment still names the kitty and the window it came from, so
it is found that way and listed as detached rather than lost entirely.

    kjobs            the picker (bound to F2 in kitty.conf)
    kjobs --json     the same rows as JSON, for scripts and verification

Keys: j/k move, space mark, tab fold a row's children away, s cycle sort,
x SIGTERM, X SIGKILL, enter focus that pane, r refresh, q or F2 quit. Killing a
job signals its process group; killing one of its children signals only
that process.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
from glob import glob

# A pane's own shell plumbing, walked through rather than reported: kitty
# starts panes as `login -f -l -p USER kitten run-shell --shell /bin/zsh`.
PLUMBING = {'login', 'kitten', 'kitty'}
SHELLS = {'zsh', 'bash', 'sh', 'fish', 'dash', 'ksh', 'csh', 'tcsh'}
AGENTS = {'claude'}
# Detached services meant to outlive the pane that started them. Worth
# counting, not worth a row each, so they arrive folded behind one row.
DAEMONS = {'colima', 'limactl', 'lima', 'dockerd', 'docker', 'podman',
           'qemu-system-aarch64', 'vfkit', 'ollama', 'redis-server',
           'postgres', 'mysqld', 'mariadbd', 'mongod', 'elasticsearch'}
# `node /Users/x/.nvm/versions/node/v24.11.0/bin/yarn dev` is `yarn dev`, and
# `bash /Users/x/.local/bin/wt-help` is `wt-help`.
INTERPRETERS = {'node', 'python', 'python3', 'ruby', 'perl', 'bun', 'deno',
                'sh', 'bash', 'zsh', 'fish'}
TERM_GRACE = 8.0  # how long a row keeps saying "terminating..."
SORTS = ('tab', 'cpu', 'mem', 'age')
DAEMON_PID = -1  # the folded daemon row: a heading, never something to signal
PORT_W = 7       # ':3005+2'

# pid -> (subtree cpu seconds, wall clock) from the previous sample, which is
# what turns cumulative CPU time into a percentage over the refresh interval.
_cpu_prev: dict[int, tuple[float, float]] = {}

# What cannot change while a process lives, so it is only ever asked once:
# its environment, and -- for a job with no shell left to cd it -- its cwd.
# Both are pruned to the live process table on every refresh.
_env_cache: dict[int, tuple[int, int] | None] = {}
_cwd_cache: dict[int, str] = {}


def die(msg: str) -> None:
    print(f'kjobs: {msg}', file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------------------
# Data
# --------------------------------------------------------------------------
def socket_address() -> str:
    addr = os.environ.get('KITTY_LISTEN_ON')
    if addr:
        return addr
    # Not launched from kitty: fall back to kitty.conf's listen_on pattern.
    found = glob('/tmp/kitty-[0-9]*')
    if not found:
        die('no kitty socket: is allow_remote_control on and listen_on set?')
    newest = max(found, key=lambda path: int(path.rsplit('-', 1)[1]))
    return 'unix:' + newest


def kitty_ls() -> list:
    try:
        out = subprocess.run(
            ['kitty', '@', '--to', socket_address(), 'ls'],
            capture_output=True, text=True, timeout=5, check=True,
        ).stdout
    except FileNotFoundError:
        die('kitty is not on PATH')
    except subprocess.TimeoutExpired:
        die('kitty @ ls timed out')
    except subprocess.CalledProcessError as e:
        die(f'kitty @ ls failed: {e.stderr.strip()}')
    return json.loads(out)


def kitty_pid() -> int | None:
    """This kitty's pid -- what a detached job's KITTY_PID has to match."""
    value = os.environ.get('KITTY_PID')
    if not value:
        # listen_on is `unix:/tmp/kitty-{kitty_pid}`, which is how
        # socket_address found this one in the first place.
        value = socket_address().rsplit('-', 1)[-1]
    try:
        return int(value)
    except ValueError:
        return None


def kitty_env(pids: list[int]) -> dict[int, tuple[int, int]]:
    """(KITTY_PID, KITTY_WINDOW_ID) for each of `pids` that carries them.

    Cached per pid, misses included: reading 400 environments costs more than
    everything else this does put together, and none of them can change.
    """
    missing = [pid for pid in pids if pid not in _env_cache]
    if missing:
        found = read_kitty_env(missing)
        for pid in missing:
            _env_cache[pid] = found.get(pid)
    return {pid: _env_cache[pid] for pid in pids if _env_cache.get(pid)}


def read_kitty_env(pids: list[int]) -> dict[int, tuple[int, int]]:
    """KITTY_PID and KITTY_WINDOW_ID straight out of each pid's environment.

    A process keeps its environment when its parent dies, so this is all that
    is left of a detached job's origin once the process tree no longer leads
    back to a pane. `ps -E` prints the environment after argv, and the last
    assignment wins, so a value that was only ever an argument cannot shadow
    the real one.
    """
    if not pids:
        return {}
    args = ['ps', '-Eww', '-o', 'pid=,args=']
    for pid in pids:
        args += ['-p', str(pid)]
    try:
        out = subprocess.run(args, capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    found: dict[int, tuple[int, int]] = {}
    for line in out.splitlines():
        head, _, rest = line.strip().partition(' ')
        try:
            pid = int(head)
        except ValueError:
            continue
        kitty = window = ''
        for token in rest.split():
            name, sep, value = token.partition('=')
            if sep and name == 'KITTY_PID':
                kitty = value
            elif sep and name == 'KITTY_WINDOW_ID':
                window = value
        if kitty.isdigit():
            found[pid] = (int(kitty), int(window) if window.isdigit() else 0)
    return found


def listening_ports() -> dict[int, set[int]]:
    """pid -> the TCP ports it is listening on; empty if lsof cannot say.

    This is the column that tells a forgotten dev server apart from a build
    that is merely slow, so it is never allowed to break the list.
    """
    try:
        out = subprocess.run(
            ['lsof', '-nP', '-iTCP', '-sTCP:LISTEN', '-F', 'pn'],
            capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    ports: dict[int, set[int]] = {}
    pid = None
    for line in out.splitlines():
        if line.startswith('p'):
            pid = int(line[1:]) if line[1:].isdigit() else None
        elif line.startswith('n') and pid is not None:
            # `*:3000`, `127.0.0.1:3000`, `[::1]:3000`.
            _, sep, tail = line[1:].rpartition(':')
            if sep and tail.isdigit():
                ports.setdefault(pid, set()).add(int(tail))
    return ports


def working_dirs(pids: list[int]) -> dict[int, str]:
    """cwd per pid. kitty reports this for a pane's foreground processes;
    a detached job has no pane left to ask -- and nothing left to cd it
    either, which is what makes this safe to cache."""
    missing = [pid for pid in pids if pid not in _cwd_cache]
    if missing:
        found = read_working_dirs(missing)
        for pid in missing:
            _cwd_cache[pid] = found.get(pid, '')
    return {pid: _cwd_cache[pid] for pid in pids}


def read_working_dirs(pids: list[int]) -> dict[int, str]:
    """cwd per pid, from lsof."""
    if not pids:
        return {}
    args = ['lsof', '-a', '-d', 'cwd', '-F', 'n', '-p',
            ','.join(str(pid) for pid in pids)]
    try:
        out = subprocess.run(args, capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    dirs: dict[int, str] = {}
    pid = None
    for line in out.splitlines():
        if line.startswith('p'):
            pid = int(line[1:]) if line[1:].isdigit() else None
        elif line.startswith('n') and pid is not None:
            dirs[pid] = line[1:]
    return dirs


def clock_seconds(value: str) -> float:
    """[[dd-]hh:]mm:ss -- both ps etime and ps time -- as seconds."""
    days = 0
    rest = value.strip()
    try:
        if '-' in rest:
            head, rest = rest.split('-', 1)
            days = int(head)
        bits = [float(b) for b in rest.split(':')] if rest else [0.0]
    except ValueError:
        return 0.0
    total = 0.0
    for bit in bits:
        total = total * 60 + bit
    return total + days * 86400


def process_table() -> dict[int, dict]:
    """The process table in one call, keyed by pid."""
    out = subprocess.run(
        ['ps', '-axo', 'pid=,ppid=,pgid=,state=,etime=,time=,%cpu=,rss=,args='],
        capture_output=True, text=True, check=True,
    ).stdout
    table: dict[int, dict] = {}
    for line in out.splitlines():
        parts = line.split(None, 8)
        if len(parts) < 9:
            continue
        pid, ppid, pgid, state, etime, cputime, pcpu, rss, args = parts
        if state.startswith('Z'):
            continue  # a zombie is not something to list or signal
        try:
            table[int(pid)] = {
                'pid': int(pid), 'ppid': int(ppid), 'pgid': int(pgid),
                'etime': etime, 'cpu_seconds': clock_seconds(cputime),
                'pcpu': float(pcpu), 'rss_kb': int(rss), 'args': args,
            }
        except ValueError:
            continue
    return table


def children_of(table: dict[int, dict]) -> dict[int, list[int]]:
    kids: dict[int, list[int]] = {}
    for proc in table.values():
        kids.setdefault(proc['ppid'], []).append(proc['pid'])
    return kids


def basename_of(args: str) -> str:
    first = args.split(None, 1)[0] if args else ''
    # ps prints `(zsh)` when it cannot read a process's argv -- a shell still
    # exec'ing, most often. It is the same shell, so match it as one.
    return os.path.basename(first).strip('()')


def shell_name(args: str) -> str:
    """basename_of without the leading `-` a login shell puts in its argv[0]."""
    return basename_of(args).lstrip('-')


def is_wrapper(args: str) -> bool:
    """A `shell -c …` standing in front of the command it was given.

    Claude Code runs every Bash tool call as one of these, so without walking
    through them the tree is a wall of `zsh -c source snapshot-….sh …` with
    the command you care about hidden one level under each.
    """
    tokens = args.split()
    if shell_name(args) not in SHELLS or len(tokens) < 2:
        return False
    # `-c`, and clusters like `-lc`; never a long option such as `--command`.
    return any(t.startswith('-') and not t.startswith('--') and 'c' in t[1:]
               for t in tokens[1:3])


def is_transparent(args: str) -> bool:
    """True for what stands between a pane and the commands actually running.

    Pane plumbing, a `-c` wrapper, and a shell that was given no work of its
    own -- an interactive or login shell, however many flags it carries. A
    shell handed a script (`sh ./run_main.sh`) is a command in its own right.
    """
    if shell_name(args) in PLUMBING:
        return True
    if shell_name(args) not in SHELLS:
        return False
    return is_wrapper(args) or all(t.startswith('-') for t in args.split()[1:])


def pretty_cmd(args: str) -> str:
    """The command as you would have typed it: no interpreter, no full paths."""
    tokens = args.split()
    if not tokens:
        return args
    if is_wrapper(args):
        return f'{shell_name(args)} -c …'  # the script body is never readable
    if (os.path.basename(tokens[0]) in INTERPRETERS and len(tokens) > 1
            and tokens[1].startswith('/')):
        tokens = tokens[1:]
    return ' '.join(os.path.basename(t) if t.startswith('/') else t
                    for t in tokens)


def ancestors(pid: int, table: dict[int, dict]) -> set[int]:
    seen: set[int] = set()
    while pid in table and pid not in seen:
        seen.add(pid)
        pid = table[pid]['ppid']
    return seen


def descendants(pid: int, kids: dict[int, list[int]]) -> set[int]:
    """Every pid below pid, however deep -- what a pane already accounts for."""
    seen: set[int] = set()
    stack = list(kids.get(pid, ()))
    while stack:
        current = stack.pop()
        if current in seen:
            continue
        seen.add(current)
        stack.extend(kids.get(current, ()))
    return seen


def topmost_jobs(pid: int, table, kids, depth: int = 0) -> list[dict]:
    """Descend from pid through shells; report the first real commands found."""
    if depth > 12:
        return []
    proc = table.get(pid)
    if proc is None:
        return []
    if not is_transparent(proc['args']):
        return [proc]
    jobs: list[dict] = []
    for kid in kids.get(pid, ()):
        jobs.extend(topmost_jobs(kid, table, kids, depth + 1))
    # A wrapper with nothing under it has no command to defer to: whatever it
    # is doing, it is doing itself, so report it rather than lose it.
    if not jobs and is_wrapper(proc['args']):
        return [proc]
    return jobs


def subtree(pid: int, table, kids, depth: int = 1) -> list[tuple[int, dict]]:
    """(depth, proc) for every descendant of pid -- what a kill takes down.

    Shell wrappers included: they are not worth a row, but their CPU and
    memory are still charged to the job that a kill would remove.
    """
    out: list[tuple[int, dict]] = []
    if depth > 12:
        return out
    for kid in kids.get(pid, ()):
        proc = table.get(kid)
        if proc is None:
            continue
        out.append((depth, proc))
        out.extend(subtree(kid, table, kids, depth + 1))
    return out


def real_tree(pid: int, table, kids, depth: int = 1) -> list[tuple[int, dict]]:
    """(depth, proc) for every real command below pid, wrappers walked through.

    A skipped wrapper takes its depth with it, so the command it was running
    sits directly under the job rather than one level in from nothing.
    """
    out: list[tuple[int, dict]] = []
    if depth > 12:
        return out
    for kid in kids.get(pid, ()):
        for proc in topmost_jobs(kid, table, kids):
            out.append((depth, proc))
            out.extend(real_tree(proc['pid'], table, kids, depth + 1))
    return out


def tab_name(tab: dict, windows: list[dict], mine: set[int]) -> str:
    """The tab's name as the tab bar shows it, ignoring this picker's overlay.

    An unnamed tab takes its title from the active window, and this picker is
    itself an overlay -- so reading tab['title'] would label the tab you pressed
    F2 in "Running". Other overlays are left in: when `wt-help` is up, the tab
    bar really does say "Shortcuts".
    """
    others = [w for w in windows if w['pid'] not in mine]
    if tab.get('title_overridden') or not others:
        return tab['title']
    by_id = {w['id']: w for w in others}
    for window_id in tab.get('active_window_history', ()):
        if window_id in by_id:
            return by_id[window_id]['title'] or tab['title']
    return others[0]['title'] or tab['title']


def session_label(title: str) -> str:
    """A pane title worth appending to `claude`, or '' for a path-ish one."""
    title = (title or '').strip()
    if not title or title[0] in '~…/' or title.startswith('.'):
        return ''
    return title


def cpu_percent(pid: int, cpu_seconds: float, now: float, pcpu: float) -> float:
    """CPU over the last refresh interval; ps's lifetime average until then."""
    previous = _cpu_prev.get(pid)
    _cpu_prev[pid] = (cpu_seconds, now)
    if previous is None:
        return pcpu
    prev_cpu, prev_at = previous
    elapsed = now - prev_at
    if elapsed < 0.5 or cpu_seconds < prev_cpu:
        return pcpu
    return max(0.0, (cpu_seconds - prev_cpu) / elapsed * 100)


def ports_under(pid: int, below, ports: dict[int, set[int]]) -> list[int]:
    """Ports listened on by a job or anything under it -- `yarn dev` should
    carry the port its nodemon opened."""
    found = set(ports.get(pid, ()))
    for _, proc in below:
        found |= ports.get(proc['pid'], set())
    return sorted(found)


def job_row(proc, table, kids, now, ports, *, label, agent, where,
            window_id=None, shell_pgid=None, tab_label='', pane=0,
            at_prompt=False, cwd='', fg_cwd=None, detached=False) -> dict:
    """One top-level row and the tree of real commands nested under it."""
    fg_cwd = fg_cwd or {}
    below = subtree(proc['pid'], table, kids)
    shown = real_tree(proc['pid'], table, kids)
    cpu_seconds = proc['cpu_seconds'] + sum(p['cpu_seconds'] for _, p in below)
    rss_kb = proc['rss_kb'] + sum(p['rss_kb'] for _, p in below)
    pcpu = proc['pcpu'] + sum(p['pcpu'] for _, p in below)
    return {
        'pid': proc['pid'],
        'pgid': proc['pgid'],
        'shell_pgid': shell_pgid,
        'cmd': label,
        'args': proc['args'],
        'name': basename_of(label),
        'elapsed': proc['etime'],
        'age': clock_seconds(proc['etime']),
        'cpu': cpu_percent(proc['pid'], cpu_seconds, now, pcpu),
        'mem_kb': rss_kb,
        'ports': ports_under(proc['pid'], below, ports),
        'agent': agent,
        'cwd': fg_cwd.get(proc['pid']) or cwd,
        'where': where,
        'window_id': window_id,
        'tab_title': tab_label,
        'pane': pane,
        'at_prompt': at_prompt,
        'kill_group': True,
        'depth': 0,
        'detached': detached,
        'synthetic': False,
        'children': [{
            'pid': child['pid'],
            'pgid': child['pgid'],
            'shell_pgid': None,
            'cmd': pretty_cmd(child['args']),
            'args': child['args'],
            'name': basename_of(child['args']),
            'elapsed': child['etime'],
            'age': clock_seconds(child['etime']),
            'cpu': cpu_percent(child['pid'], child['cpu_seconds'], now,
                               child['pcpu']),
            'mem_kb': child['rss_kb'],
            'ports': ports_under(child['pid'],
                                 subtree(child['pid'], table, kids), ports),
            'agent': False,
            'cwd': fg_cwd.get(child['pid'], ''),
            'where': '',
            'window_id': window_id,
            # A child shares its parent's process group, so signalling the
            # group here would kill the job too.
            'kill_group': False,
            'depth': depth,
            'detached': detached,
            'synthetic': False,
            'children': [],
        } for depth, child in shown],
    }


def detached_jobs(table, kids, covered, now, ports, panes) -> list[dict]:
    """Jobs this kitty started that no pane can reach any more.

    When the shell that started a dev server exits, launchd adopts what it
    left running: the job keeps its port and its memory, but walking down
    from the panes can never find it again -- which is exactly how one runs
    for a day unnoticed. Its environment still names this kitty and the
    window it came from, and that is what identifies it here.
    """
    ours = kitty_pid()
    if ours is None:
        return []
    # A covered process's children are covered too, so the tops of what is
    # left -- the ones whose parent is not also uncovered -- are exactly the
    # processes that were adopted away from a pane.
    loose = set(table) - covered
    orphans = [pid for pid in loose if table[pid]['ppid'] not in loose]
    origins = {pid: window for pid, (kitty, window)
               in kitty_env(orphans).items() if kitty == ours}
    found = [(window, proc) for root, window in origins.items()
             for proc in topmost_jobs(root, table, kids)]
    cwds = working_dirs([proc['pid'] for _, proc in found])
    jobs: list[dict] = []
    for window, proc in found:
        origin = panes.get(window)
        label = pretty_cmd(proc['args'])
        jobs.append(job_row(
            proc, table, kids, now, ports,
            label=label, agent=basename_of(label) in AGENTS,
            where='⌁ ' + (origin['where'] if origin else 'detached'),
            window_id=origin['id'] if origin else None,
            tab_label=origin['tab'] if origin else '',
            pane=origin['pane'] if origin else 0,
            cwd=cwds.get(proc['pid'], ''), detached=True))
    return jobs


def daemon_summary(daemons: list[dict]) -> dict:
    """One folded row standing in for the services a pane left running.

    colima, a database, a docker VM: started from a terminal, meant to
    outlive it, and never the thing you opened this list to find. They still
    count towards the totals, and `tab` opens them for a kill.
    """
    children: list[dict] = []
    for job in sorted(daemons, key=lambda r: r['cmd']):
        children.append({**job, 'depth': 1, 'where': '', 'children': []})
        for child in job['children']:
            children.append({**child, 'depth': child['depth'] + 1})
    oldest = max(daemons, key=lambda r: r['age'])
    return {
        'pid': DAEMON_PID, 'pgid': None, 'shell_pgid': None,
        'cmd': f'{len(daemons)} daemon' + ('s' if len(daemons) > 1 else ''),
        'args': '', 'name': 'daemons',
        'elapsed': oldest['elapsed'], 'age': oldest['age'],
        'cpu': sum(job['cpu'] for job in daemons),
        'mem_kb': sum(job['mem_kb'] for job in daemons),
        'ports': sorted({port for job in daemons for port in job['ports']}),
        'agent': False, 'cwd': '', 'where': '⌁ background',
        'window_id': None, 'tab_title': '', 'pane': 0, 'at_prompt': False,
        'kill_group': False, 'depth': 0,
        'detached': True, 'synthetic': True, 'children': children,
    }


def collect() -> list[dict]:
    """One row per running command, across every pane of this kitty."""
    table = process_table()
    kids = children_of(table)
    for cache in (_env_cache, _cwd_cache):
        for pid in set(cache) - set(table):
            del cache[pid]
    mine = ancestors(os.getpid(), table)
    ports = listening_ports()
    os_windows = kitty_ls()
    multi = len(os_windows) > 1
    now = time.monotonic()
    rows: list[dict] = []
    covered: set[int] = set(mine)
    panes_by_id: dict[int, dict] = {}
    for wi, osw in enumerate(os_windows, 1):
        for tab in osw['tabs']:
            # A group is one pane: its base window plus any overlay stacked on
            # it. kitty does not say which member is the base -- it reorders the
            # list as they are focused, so `windows[0]` is not it -- and there is
            # no need to know: every window of a group shares the group's pane
            # number, and an overlay running something (`wt-help`, `kdiff`) is a
            # job like any other.
            by_id = {w['id']: w for w in tab['windows']}
            groups = tab.get('groups') or [{'windows': [w['id']]}
                                           for w in tab['windows']]
            panes = [(pi, by_id[wid])
                     for pi, group in enumerate(groups, 1)
                     for wid in group['windows'] if wid in by_id]
            tab_label = tab_name(tab, tab['windows'], mine)
            for pi, win in panes:
                where = f'{tab_label} · pane {pi}'
                if multi:
                    where = f'win{wi} · ' + where
                covered.add(win['pid'])
                covered |= descendants(win['pid'], kids)
                panes_by_id[win['id']] = {'where': where, 'tab': tab_label,
                                          'pane': pi, 'id': win['id']}
                # kitty knows each foreground process's own cwd; ps does not.
                fg_cwd = {p['pid']: p['cwd']
                          for p in win.get('foreground_processes', ())
                          if p.get('cwd')}
                for proc in topmost_jobs(win['pid'], table, kids):
                    if proc['pid'] in mine:
                        continue  # never list kjobs or the pane it runs in
                    label = pretty_cmd(proc['args'])
                    name = basename_of(label)
                    agent = name in AGENTS
                    if agent:
                        session = session_label(win['title'])
                        if session:
                            label = f'{name} {session}'
                    rows.append(job_row(
                        proc, table, kids, now, ports,
                        label=label, agent=agent, where=where,
                        window_id=win['id'],
                        shell_pgid=table.get(win['pid'], {}).get('pgid'),
                        tab_label=tab_label, pane=pi,
                        at_prompt=win['at_prompt'], cwd=win['cwd'],
                        fg_cwd=fg_cwd))

    rows += detached_jobs(table, kids, covered, now, ports, panes_by_id)
    daemons = [row for row in rows if row['detached'] and row['name'] in DAEMONS]
    if daemons:
        folded = {row['pid'] for row in daemons}
        rows = [row for row in rows if row['pid'] not in folded]
        rows.append(daemon_summary(daemons))

    stale = set(_cpu_prev) - {r['pid'] for r in rows} - {
        c['pid'] for r in rows for c in r['children']}
    for pid in stale:
        del _cpu_prev[pid]
    return sort_rows(rows, 'tab')


def sort_rows(rows: list[dict], mode: str) -> list[dict]:
    if mode == 'cpu':
        return sorted(rows, key=lambda r: (-r['cpu'], r['where'], r['pid']))
    if mode == 'mem':
        return sorted(rows, key=lambda r: (-r['mem_kb'], r['where'], r['pid']))
    if mode == 'age':
        return sorted(rows, key=lambda r: (-r['age'], r['where'], r['pid']))
    # Live work first, then agents, then what no pane is holding any more --
    # with the folded daemons at the very bottom of that.
    return sorted(rows, key=lambda r: (r['detached'], r['synthetic'],
                                       r['agent'], r['where'], r['pid']))


def kill_row(row: dict, sig: int) -> str | None:
    """Signal the row's process group, or the pid alone when that isn't safe."""
    pgid, pid = row['pgid'], row['pid']
    if pid <= 1:
        return None  # a heading row, not a process: os.kill(-1) is everything
    group = row.get('kill_group') and pgid and pgid != row.get('shell_pgid')
    try:
        os.kill(-pgid if group else pid, sig)
    except ProcessLookupError:
        return None  # already gone; the next refresh drops the row
    except PermissionError:
        return f'not permitted to signal {pid}'
    except OSError as e:
        return f'{pid}: {e}'
    return None


# --------------------------------------------------------------------------
# Display helpers
# --------------------------------------------------------------------------
def short_cwd(path: str, width: int = 0) -> str:
    """~-relative, and elided in the middle only when it will not fit."""
    if not path:
        return ''
    home = os.path.expanduser('~')
    if path == home:
        return '~'
    if path.startswith(home + '/'):
        path = '~/' + path[len(home) + 1:]
    if width and len(path) <= width:
        return path
    parts = path.split('/')
    if len(parts) > 3:
        parts = [parts[0], '…'] + parts[-2:]
    return '/'.join(parts)


def short_elapsed(etime: str) -> str:
    """ps etime as 3s / 21m / 3h / 2d."""
    total = clock_seconds(etime)
    if total >= 86400:
        return f'{int(total // 86400)}d'
    if total >= 3600:
        hours = int(total // 3600)
        minutes = int(total % 3600 // 60)
        return f'{hours}h{minutes:02d}' if hours < 10 else f'{hours}h'
    if total >= 60:
        return f'{int(total // 60)}m'
    return f'{int(total)}s'


def short_mem(kb: int) -> str:
    if kb >= 1024 * 1024:
        return f'{kb / 1024 / 1024:.1f}G'
    if kb >= 1024:
        return f'{int(kb / 1024)}M'
    return f'{kb}K' if kb else ''


def short_port(ports: list[int]) -> str:
    """The first port a job listens on, and how many more it is holding."""
    if not ports:
        return ''
    extra = f'+{len(ports) - 1}' if len(ports) > 1 else ''
    return f':{ports[0]}{extra}'


def short_cpu(percent: float) -> str:
    if percent >= 10:
        return f'{percent:.0f}%'
    if percent >= 0.5:
        return f'{percent:.1f}%'
    return '·'


def truncate(text: str, width: int) -> str:
    if width <= 0:
        return ''
    return text if len(text) <= width else text[:max(0, width - 1)] + '…'


# --------------------------------------------------------------------------
# TUI
# --------------------------------------------------------------------------
HELP = ('[j/k] move  [space] mark  [tab] fold  [s] sort  [x] TERM  '
        '[X] KILL  [↵] focus pane  [r] refresh  [q/F2] close')


class Picker:
    def __init__(self, screen):
        self.screen = screen
        self.jobs: list[dict] = []
        self.visible: list[dict] = []
        self.cursor = 0
        self.marked: set[int] = set()
        # Tracked as the exception, so a job that appears between refreshes
        # arrives with its tree open rather than needing a keypress.
        self.collapsed: set[int] = set()
        self.dying: dict[int, float] = {}
        # The daemon row opens folded the first time it appears; after that
        # whether it is open is the user's business, like any other fold.
        self.saw_daemons = False
        self.show_ports = False
        self.sort = 'tab'
        self.message = ''
        self.last_load = 0.0
        self.load()

    # -- state -----------------------------------------------------------
    def load(self) -> None:
        keep = self.visible[self.cursor]['pid'] if self.visible else None
        self.jobs = sort_rows(collect(), self.sort)
        self.collapsed &= {job['pid'] for job in self.jobs}
        daemons = any(job['pid'] == DAEMON_PID for job in self.jobs)
        if daemons and not self.saw_daemons:
            self.collapsed.add(DAEMON_PID)
        self.saw_daemons = daemons
        # Held steady while folds open and close so the columns do not shift
        # under the cursor, and dropped entirely when nothing is listening.
        self.show_ports = any(row['ports'] for job in self.jobs
                              for row in (job, *job['children']))
        self.flatten()
        alive = {row['pid'] for row in self.visible}
        self.marked &= alive
        self.dying = {pid: at for pid, at in self.dying.items()
                      if pid in alive and time.monotonic() - at < TERM_GRACE}
        if keep is not None:
            for i, row in enumerate(self.visible):
                if row['pid'] == keep:
                    self.cursor = i
                    break
        self.cursor = max(0, min(self.cursor, len(self.visible) - 1))
        self.last_load = time.monotonic()

    def flatten(self) -> None:
        """Jobs, each followed by its children unless it has been folded."""
        self.visible = []
        for job in self.jobs:
            self.visible.append(job)
            if job['pid'] not in self.collapsed:
                self.visible.extend(job['children'])

    def row(self) -> dict | None:
        return self.visible[self.cursor] if self.visible else None

    # -- drawing ---------------------------------------------------------
    def put(self, y: int, x: int, text: str, attr: int = 0) -> None:
        """addnstr that tolerates an overlay too small for what it draws."""
        import curses
        _, width = self.screen.getmaxyx()
        try:
            self.screen.addnstr(y, x, text, max(0, width - x - 1), attr)
        except curses.error:
            pass

    def draw(self) -> None:
        import curses
        scr = self.screen
        scr.erase()
        height, width = scr.getmaxyx()

        # Every real command, folded away or not -- the count is what is
        # running, not what happens to be on screen.
        agents = sum(1 for job in self.jobs if job['agent'])
        # The daemon row is a heading, not a command; what it hides still counts.
        live = sum(len(job['children']) + (not job['synthetic'])
                   for job in self.jobs) - agents
        cpu = sum(job['cpu'] for job in self.jobs)
        mem = sum(job['mem_kb'] for job in self.jobs)
        left = f' Running ({live})  ·  {short_cpu(cpu)} cpu  ·  {short_mem(mem)}'
        right = f'sort: {self.sort} '
        loose = sum(1 for job in self.jobs
                    if job['detached'] and not job['synthetic'])
        if loose:
            right = f'{loose} detached  ·  ' + right
        if agents:
            right = f'{agents} agent{"s" if agents > 1 else ""}  ·  ' + right
        pad = max(1, width - 1 - len(left) - len(right))
        self.put(0, 0, left + ' ' * pad + right,
                 curses.color_pair(1) | curses.A_BOLD)

        body_top, body_bottom = 2, height - 3
        rows_fit = max(1, body_bottom - body_top + 1)
        first = max(0, min(self.cursor - rows_fit // 2,
                           max(0, len(self.visible) - rows_fit)))
        if not self.visible:
            self.put(body_top + 1, 2, 'Nothing running.', curses.A_DIM)
        for offset, row in enumerate(self.visible[first:first + rows_fit]):
            self.draw_row(offset + body_top, first + offset, row, width)

        if self.message:
            self.put(height - 2, 1, truncate(self.message, width - 2),
                     curses.color_pair(3) | curses.A_BOLD)
        self.put(height - 1, 1, truncate(HELP, width - 2), curses.A_DIM)
        scr.refresh()

    def columns(self, width: int) -> tuple[int, int, int]:
        # Fixed: mark, four gaps, elapsed, cpu, mem, and the gap before cwd.
        fixed = 1 + 1 + 1 + 5 + 1 + 5 + 1 + 6 + 2
        if self.show_ports:
            fixed += PORT_W + 1
        avail = max(24, width - 1 - fixed)
        where_w = min(22, max(10, avail // 4))
        cmd_w = min(52, max(12, avail - where_w - 12))
        cwd_w = max(0, avail - where_w - cmd_w)
        return where_w, cmd_w, cwd_w

    def draw_row(self, y: int, index: int, row: dict, width: int) -> None:
        import curses
        selected = index == self.cursor
        dying = row['pid'] in self.dying
        child = row['depth'] > 0
        attr = curses.A_REVERSE if selected else curses.A_NORMAL
        if row['agent'] or dying or child:
            attr |= curses.A_DIM
        if row['detached']:
            # The whole point of these rows is that you did not know they were
            # running, so they are the one thing in the list that is coloured.
            attr |= curses.color_pair(3)

        where_w, cmd_w, cwd_w = self.columns(width)
        if row['children']:
            glyph = '▸ ' if row['pid'] in self.collapsed else '▾ '
        else:
            glyph = '  '
        cmd = 'terminating…' if dying else row['cmd']
        if child:
            cmd = '  ' * (row['depth'] - 1) + '└ ' + cmd
            glyph = '  '
        port = (truncate(short_port(row['ports']), PORT_W).rjust(PORT_W)
                + ' ' if self.show_ports else '')
        line = (f"{'•' if row['pid'] in self.marked else ' '} "
                f"{truncate(row['where'], where_w).ljust(where_w)} "
                f"{truncate(glyph + cmd, cmd_w).ljust(cmd_w)} "
                f"{short_elapsed(row['elapsed']).rjust(5)} "
                f"{short_cpu(row['cpu']).rjust(5)} "
                f"{short_mem(row['mem_kb']).rjust(6)}  "
                f"{port}"
                f"{truncate(short_cwd(row['cwd'], cwd_w), cwd_w)}")
        self.put(y, 0, line.ljust(max(0, width - 1)), attr)

    # -- actions ---------------------------------------------------------
    def targets(self) -> list[dict]:
        if self.marked:
            return [row for row in self.visible if row['pid'] in self.marked]
        row = self.row()
        return [row] if row and not row['synthetic'] else []

    def confirm(self, prompt: str) -> bool:
        import curses
        height, width = self.screen.getmaxyx()
        self.put(height - 2, 1, truncate(prompt + '  y/n', width - 2),
                 curses.color_pair(3) | curses.A_BOLD)
        self.screen.refresh()
        while True:
            key = self.screen.getch()
            if key in (ord('y'), ord('Y')):
                return True
            if key != -1:
                return False

    def kill(self, sig: int) -> None:
        rows = self.targets()
        if not rows:
            row = self.row()
            if row is not None and row['synthetic']:
                self.message = 'open it with tab and kill a daemon by name'
            return
        name = 'SIGKILL' if sig == signal.SIGKILL else 'SIGTERM'
        if len(rows) > 1:
            # Marks survive a cancel, so name what is about to be signalled.
            listed = ', '.join(r['name'] for r in rows[:4])
            if len(rows) > 4:
                listed += f' +{len(rows) - 4} more'
            if not self.confirm(f'{name} {len(rows)} marked: {listed}?'):
                self.message = 'cancelled'
                return
        errors = [err for err in (kill_row(r, sig) for r in rows) if err]
        for row in rows:
            self.dying[row['pid']] = time.monotonic()
        self.marked.clear()
        self.message = ('; '.join(errors) if errors else
                        f'{name} → ' + ', '.join(r['name'] for r in rows))
        self.load()

    def toggle_children(self) -> None:
        row = self.row()
        if row is None or row['depth'] or not row['children']:
            return
        self.collapsed ^= {row['pid']}
        self.flatten()
        self.cursor = self.visible.index(row)

    def cycle_sort(self) -> None:
        self.sort = SORTS[(SORTS.index(self.sort) + 1) % len(SORTS)]
        self.jobs = sort_rows(self.jobs, self.sort)
        self.flatten()
        self.cursor = 0

    def focus(self) -> bool:
        row = self.row()
        if row is None:
            return False
        if not row['window_id']:
            self.message = 'nothing to focus: this outlived the pane that ran it'
            return False
        subprocess.run(['kitty', '@', '--to', socket_address(), 'focus-window',
                        '--match', f"id:{row['window_id']}"],
                       capture_output=True, text=True)
        return True

    def run(self) -> None:
        import curses
        curses.curs_set(0)
        self.screen.timeout(500)
        while True:
            self.draw()
            key = self.screen.getch()
            last = max(0, len(self.visible) - 1)
            # F2 opened this; kitty.conf unmaps it while the list is focused
            # so that the second press arrives here and closes it, rather than
            # stacking a second overlay on top of the first.
            if key in (ord('q'), ord('Q'), 27, curses.KEY_F2):
                return
            if key in (ord('j'), curses.KEY_DOWN):
                self.cursor = min(self.cursor + 1, last)
            elif key in (ord('k'), curses.KEY_UP):
                self.cursor = max(self.cursor - 1, 0)
            elif key in (ord('g'), curses.KEY_HOME):
                self.cursor = 0
            elif key in (ord('G'), curses.KEY_END):
                self.cursor = last
            elif key == ord(' ') and self.visible:
                if not self.visible[self.cursor]['synthetic']:
                    self.marked ^= {self.visible[self.cursor]['pid']}
                self.cursor = min(self.cursor + 1, last)
            elif key == ord('\t'):
                self.toggle_children()
            elif key in (ord('s'), ord('S')):
                self.cycle_sort()
            elif key == ord('x'):
                self.kill(signal.SIGTERM)
            elif key == ord('X'):
                self.kill(signal.SIGKILL)
            elif key in (ord('r'), ord('R')):
                self.message = ''
                self.load()
            elif key in (curses.KEY_ENTER, 10, 13):
                if self.focus():
                    return
            if time.monotonic() - self.last_load > 2.0:
                self.load()


def main(argv: list[str]) -> int:
    if '-h' in argv or '--help' in argv:
        print(__doc__.strip())
        return 0
    if '--json' in argv:
        json.dump(collect(), sys.stdout, indent=1)
        print()
        return 0
    if argv:
        die(f'unknown argument: {argv[0]}')
    if not sys.stdout.isatty():
        die('not a terminal; use --json')
    import curses
    curses.wrapper(_start)
    return 0


def _start(screen) -> None:
    import curses
    curses.use_default_colors()
    try:
        curses.init_pair(1, 111, -1)  # heading blue, as in wt-help
        curses.init_pair(3, 214, -1)  # message amber
    except curses.error:
        curses.init_pair(1, curses.COLOR_BLUE, -1)
        curses.init_pair(3, curses.COLOR_YELLOW, -1)
    Picker(screen).run()


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
