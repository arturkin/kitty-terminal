#!/usr/bin/env bash
# PhpStorm launcher, same shape as the JetBrains Toolbox script.
# Standalone installs land in /Applications, Toolbox ones in ~/Applications.
for app in "/Applications/PhpStorm.app" "$HOME/Applications/PhpStorm.app"; do
  [ -d "$app" ] && exec open -na "$app" --args "$@"
done
echo "phpstorm: PhpStorm.app not found in /Applications or ~/Applications" >&2
exit 127
